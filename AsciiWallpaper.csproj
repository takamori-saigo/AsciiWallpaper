<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AsciiWallpaper</RootNamespace>
    <AssemblyName>AsciiWallpaper</AssemblyName>
    <ApplicationTitle>ASCII Обои</ApplicationTitle>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray.png" LogicalName="tray.png" />
    <EmbeddedResource Include="Assets\icon.png" LogicalName="icon.png" />
  </ItemGroup>

</Project>
